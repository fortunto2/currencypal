<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- No ads, so no attribution signal to declare. -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- Tracking, in Apple's sense, means joining this data with third-party data for advertising
       or handing it to a data broker. Neither happens, so there are no tracking domains and no
       App Tracking Transparency prompt: a prompt would promise a practice that does not exist. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <!-- Which screens were opened and which actions happened. Nothing else is sent: no
           contacts, no location, no identifiers beyond the install-scoped UUID below. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <dict>
      <!-- The install-scoped UUID. Declared as a Device ID because that is the closest category
           Apple offers, and under-declaring is the worse mistake. It is NOT the IDFA and NOT
           identifierForVendor: it is generated by this app, known only to this app, and deleted
           with it — so it cannot join a person across our other apps or to an account. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- UserDefaults is a Required Reason API since May 2024. CA92.1 is the reason for reading
           and writing values belonging to this app alone, which is exactly what the anonymous id
           is. Omitting this is the single most common cause of an automatic rejection at
           upload. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
